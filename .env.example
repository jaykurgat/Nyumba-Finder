# Neon PostgreSQL connection string used by Prisma.
# Keep the real value in .env.local locally and in Vercel Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&schema=public"

# Optional: use a separate direct Neon connection for migrations when the
# runtime DATABASE_URL uses Neon's pooled endpoint.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require&schema=public"

# Admin access
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-random-password"
ADMIN_SESSION_SECRET="change-this-to-a-random-secret-at-least-32-characters"

# Optional Google Ads conversion tracking.
# Use the conversion ID beginning with AW- from Google Ads.
# Conversion labels must be copied from the matching Google Ads conversion action.
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_GOOGLE_ADS_PROPERTY_LISTING_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=""

# Optional managed Playwright browser for JavaScript-rendered property pages.
# Browser rendering runs only after a public HTTPS page returns HTTP 200 but
# appears to be an empty JavaScript shell. HTTP 403/CAPTCHA/login denials stop.
# Configure only after reviewing the browser provider's current limits and costs.
BROWSERLESS_ENABLE="false"
BROWSERLESS_API_TOKEN=""
BROWSERLESS_REGION="production-sfo"
