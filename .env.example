# Neon PostgreSQL connection string used by Prisma.
# Keep the real value in .env.local locally and in Vercel Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&schema=public"

# Optional: use a separate direct Neon connection for migrations when the
# runtime DATABASE_URL uses Neon's pooled endpoint.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require&schema=public"

# Admin access
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-random-password"
ADMIN_SESSION_SECRET="change-this-to-a-random-secret-at-least-32-characters"
