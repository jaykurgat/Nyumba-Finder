generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  EXPIRED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PromotionEventType {
  IMPRESSION
  CLICK
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  email           String?         @unique
  phone           String?         @unique
  status          UserStatus      @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  profile         UserProfile?
  tenantProfile   TenantProfile?
  landlordProfile LandlordProfile?

  @@index([status])
  @@index([createdAt])
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TenantProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model LandlordProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  data       Bytes
  mimeType   String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Property {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String   @default("")
  location     String
  price        Float
  bedrooms     Int
  bathrooms    Int      @default(1)
  sizeSqm      Float?
  amenities    String[] @default([])
  images       String[] @default([])
  countyId     String?  @db.Uuid
  townId       String?  @db.Uuid
  areaId       String?  @db.Uuid
  locationNodeId String? @db.Uuid
  latitude     Float?
  longitude    Float?
  county       County?  @relation(fields: [countyId], references: [id], onDelete: SetNull)
  town         Town?    @relation(fields: [townId], references: [id], onDelete: SetNull)
  areaLocation Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  locationNode LocationNode? @relation(fields: [locationNodeId], references: [id], onDelete: SetNull)
  phoneNumber  String?
  propertyType String @default("Apartment")
  status       PropertyStatus @default(ACTIVE)
  propertyImages PropertyImage[]
  promotions   PropertyPromotion[]
  reports      PropertyReport[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([location])
  @@index([countyId])
  @@index([townId])
  @@index([areaId])
  @@index([locationNodeId])
  @@index([latitude, longitude])
  @@index([price])
  @@index([bedrooms])
  @@index([createdAt])
  @@index([status])
  @@index([propertyType])
}

model PropertyPromotion {
  id             String          @id @default(uuid()) @db.Uuid
  propertyId     String          @db.Uuid
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  package        String          @default("Featured")
  status         PromotionStatus @default(DRAFT)
  boost          Int             @default(20)
  targetLocation String?
  targetType     String?
  minBedrooms   Int?
  maxBedrooms   Int?
  budgetCents    Int?
  spentCents     Int             @default(0)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         PromotionEvent[]

  @@index([propertyId])
  @@index([status, startsAt, endsAt])
  @@index([targetLocation])
  @@index([targetType])
}

model PromotionEvent {
  id           String              @id @default(uuid()) @db.Uuid
  promotionId  String              @db.Uuid
  promotion    PropertyPromotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  type         PromotionEventType
  createdAt    DateTime            @default(now())

  @@index([promotionId, type])
  @@index([createdAt])
}

model PropertyReport {
  id          String       @id @default(uuid()) @db.Uuid
  propertyId  String       @db.Uuid
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        String
  description String?
  status        ReportStatus @default(OPEN)
  reporterHash  String
  createdAt     DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([propertyId])
  @@index([status, createdAt])
  @@unique([propertyId, reporterHash])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model LocationNode {
  id          String   @id @default(uuid()) @db.Uuid
  countyId    String   @db.Uuid
  parentId    String?  @db.Uuid
  level       String
  name        String
  slug        String
  latitude    Float?
  longitude   Float?
  searchable Boolean  @default(true)
  source      String   @default("KEN_adm4.csv")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  county      County   @relation(fields: [countyId], references: [id], onDelete: Cascade)
  parent      LocationNode? @relation("LocationNodeParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    LocationNode[] @relation("LocationNodeParent")
  properties  Property[]
  aliases     LocationNodeAlias[]

  @@unique([countyId, level, slug, parentId])
  @@index([countyId, level])
  @@index([name])
  @@index([parentId])
}

model LocationNodeAlias {
  id          String @id @default(uuid()) @db.Uuid
  locationNodeId String @db.Uuid
  alias       String
  normalized  String @unique
  locationNode LocationNode @relation(fields: [locationNodeId], references: [id], onDelete: Cascade)

  @@index([locationNodeId])
}

model County {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  slug       String     @unique
  code       Int        @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  towns      Town[]
  properties Property[]
  locationNodes LocationNode[]

  @@index([name])
}

model Town {
  id         String     @id @default(uuid()) @db.Uuid
  countyId   String     @db.Uuid
  name       String
  slug       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  county     County     @relation(fields: [countyId], references: [id], onDelete: Cascade)
  areas      Area[]
  properties Property[]

  @@unique([countyId, slug])
  @@index([countyId])
  @@index([name])
}

model Area {
  id         String          @id @default(uuid()) @db.Uuid
  townId     String          @db.Uuid
  name       String
  slug       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  town       Town            @relation(fields: [townId], references: [id], onDelete: Cascade)
  aliases    LocationAlias[]
  properties Property[]

  @@unique([townId, slug])
  @@index([townId])
  @@index([name])
}

model LocationAlias {
  id         String   @id @default(uuid()) @db.Uuid
  areaId     String   @db.Uuid
  alias      String
  normalized String
  createdAt  DateTime @default(now())
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([normalized])
  @@index([areaId])
}
